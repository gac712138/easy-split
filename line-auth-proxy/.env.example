# ===== Supabase 設定 =====
# 你的 Supabase 專案 URL
SUPABASE_URL=https://api-easysplit.island-dev.com

# Supabase Service Role Key (Admin API 用)
# ⚠️ 注意：這是最高權限的密鑰，請勿洩露！
SERVICE_ROLE_KEY=your_service_role_key_here

# ===== LINE 登入設定 =====
# LINE Developers Console 中的 Channel ID
LINE_CHANNEL_ID=your_line_channel_id

# LINE Developers Console 中的 Channel Secret
LINE_CHANNEL_SECRET=your_line_channel_secret

# LINE OAuth 回調網址（需與 LINE Console 設定一致）
# 格式：http://localhost:3001/auth/line/callback 或 https://your-proxy-domain.com/auth/line/callback
LINE_REDIRECT_URI=http://localhost:3001/auth/line/callback

# ===== 前端應用設定 =====
# 前端應用的網址（登入成功後重定向的目標）
FRONTEND_URL=https://easysplit.island-dev.com

# ===== 伺服器設定 =====
# 伺服器監聽埠號（可選，預設 3001）
PORT=3001

# 執行環境（development/production）
NODE_ENV=development